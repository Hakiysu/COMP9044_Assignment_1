#!/bin/dash
#
# mygive-rm <assignment>
# mygive-rm removes an assignment.
# Its first argument should be the name of the assignment.

# global variables
assignment_name="$1"

mygive_dir="./.mygive"
assignments_dir="$mygive_dir/assignments"
submissions_dir="$mygive_dir/submissions"
# check if assignment name is provided
if [ -z "$assignment_name" ]; then
    echo "usage: mygive-rm <assignment>"
    exit 1
fi

# student submit dir: /mygive/submissions/assignName/zid/ver/files
# teacher test dir: /mygive/assignments/assignName/tests

# check if assignment or submissions directory exists
if [ ! -d "$assignments_dir/$assignment_name" ] && [ ! -d "$submissions_dir/$assignment_name" ]; then
    echo "assignment $assignment_name does not exist"
    exit 1
fi

# remove assignment directory and submissions directory and their contents
rm -rf "$assignments_dir/$assignment_name"
rm -rf "$submissions_dir/$assignment_name"  



echo "assignment $assignment_name removed"