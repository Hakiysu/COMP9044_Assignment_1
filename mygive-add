#!/bin/dash
#
# TEACHER: Creates a new MyGive assignment.
# example: mygive-add <assignment> <tests>
#eg: /.mygive/<assignment_name>/tests



# global variables
mygive_dir="./.mygive"
assignment_dir="$mygive_dir/assignments"

assignment_name="$1"
tests_file_path="$2"



# check command if legal
if [ $# -ne 2 ]; then
    echo "usage: mygive-add <assignment> <tests>">&2
    exit 1

# assignment name check, format:[az]*[a-zA-Z0-9_]
elif [ -z "$(echo "$assignment_name" | grep '^[a-z][a-zA-Z0-9_]*$')" ] || [ -z "$assignment_name" ]; then
    # check if assignment name is valid
    echo "mygive-add: invalid assignment: $assignment_name">&2
    exit 1

# check if assignment dir already exists
elif [ -d "$assignment_dir/$assignment_name" ]; then
    # assignment already exists, print error message to stderr
    echo "mygive-add: assignment $assignment_name already exists">&2
    exit 1


   
# if <assignment_name> dir not exist in .mygive, create it
elif [ ! -d "$assignment_dir/$assignment_name" ]; then
    # check if .mygive dir exists
    if [ ! -d ".mygive" ]; then
        # create .mygive dir
        mkdir ".mygive"
        echo "directory .mygive created"
    fi


    # check if assignments dir exist, if not, create it
    if [ ! -d "$assignment_dir" ]; then
        # create .mygive dir
        mkdir "$assignment_dir"
    fi

    # check if tests file exists
    if [ ! -f "$tests_file_path" ]; then
        # check if tests file exists
        echo "mygive-add: $tests_file_path: No such file or directory" >&2
        exit 1  
    fi

    # create <assignment_name> dir in .mygive
    mkdir "$assignment_dir/$assignment_name"
    echo "assignment $assignment_name created"
    # copy tests dirs and files to .mygive/<assignment_name>
    cp "$tests_file_path" "$assignment_dir/$assignment_name"
    
fi